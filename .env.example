# =================================================================
# Application Configuration
# =================================================================

# Application URL (used for OAuth redirects and callbacks)
APP_URL=http://localhost:3000

# Public Application URL (used by client-side components)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment (development, production, test)
NODE_ENV=development

# =================================================================
# Authentication Configuration
# =================================================================

# JWT Secret (generate a secure random string)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# JWT Expiration time (e.g., 7d, 1h, 30m)
JWT_EXPIRES_IN=7d

# Better Auth Secret (generate a secure random string; minimum 32 chars)
BETTER_AUTH_SECRET=local-dev-only-replace-with-a-long-random-value

# =================================================================
# Database Configuration
# =================================================================

# Database URL (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/nuvia?schema=public"

# =================================================================
# Google OAuth Configuration
# =================================================================

# Google OAuth Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Google OAuth Client Secret (from Google Cloud Console)
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Google OAuth Authorized Redirect URIs (add these in Google Cloud Console):
# http://localhost:3000/api/auth/callback/google (development)
# https://yourdomain.com/api/auth/callback/google (production)

# =================================================================
# Optional: Additional OAuth Providers
# =================================================================

# GitHub OAuth (uncomment to enable)
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# GitHub OAuth Authorization Callback URL (add this in GitHub OAuth App settings):
# http://localhost:3000/api/auth/callback/github (development)
# https://yourdomain.com/api/auth/callback/github (production)

# Facebook OAuth (uncomment to enable)
# FACEBOOK_CLIENT_ID=your-facebook-client-id
# FACEBOOK_CLIENT_SECRET=your-facebook-client-secret

# LinkedIn OAuth (uncomment to enable)
# LINKEDIN_CLIENT_ID=your-linkedin-client-id
# LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# =================================================================
# Email Configuration (for password reset, notifications)
# =================================================================

# Email configuration
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-password
EMAIL_FROM=noreply@yourapp.com

# Alternative: Resend API Key (for email sending)
# RESEND_API_KEY=your-resend-api-key

# =================================================================
# Rate Limiting Configuration
# =================================================================

# Max requests per window
RATE_LIMIT_MAX_REQUESTS=5

# Window in minutes
RATE_LIMIT_WINDOW_MINUTES=15

# =================================================================
# Security Configuration
# =================================================================

# =================================================================
# Upload Configuration
# =================================================================

# Max upload size in bytes (default: 5MB)
UPLOAD_MAX_SIZE=5242880

# Allowed file types (comma-separated)
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp

# =================================================================
# Logging Configuration
# =================================================================

# Log level (error, warn, info, debug)
LOGGING_LEVEL=info

# Enable request logging (true/false)
LOGGING_REQUESTS=false

# Enable error logging (true/false)
LOGGING_ERRORS=true

# =================================================================
# Feature Flags
# =================================================================

# Enable email verification (true/false)
FEATURE_EMAIL_VERIFICATION=true

# Enable social login (true/false)
FEATURE_SOCIAL_LOGIN=true

# Enable account deletion (true/false)
FEATURE_ACCOUNT_DELETION=true

# Enable password strength meter (true/false)
FEATURE_PASSWORD_STRENGTH_METER=true

# Test-only: swap better-auth's scrypt (N=16384) for a cheap test hash
# (N=1024) in every process that sees this flag. Set it only in the test
# environment shared by the test seeder and the server under test — see
# src/lib/auth/tokens.ts. Never set it in production.
# TEST_FAST_PASSWORD_HASH=true

# =================================================================
# Session Cache Configuration (Performance Optimization)
# =================================================================

# Enable Redis session caching (true/false)
# Recommended for production, optional for development
ENABLE_REDIS_CACHE=false
NEXT_PUBLIC_ENABLE_REDIS_CACHE=false

# Redis URL (required if ENABLE_REDIS_CACHE=true)
# Options:
# 1. Local Redis: redis://localhost:6379
# 2. Upstash: https://xxx.upstash.io
# 3. Railway: redis://user:pass@host:port
# 4. Redis Cloud: redis://user:pass@host:port
REDIS_URL=redis://localhost:6379

# Performance Impact:
# - With Redis: 70-80% faster session validation
# - Without Redis: Standard performance (still optimized with client-side cache)

# =================================================================
# Payment Gateway (docs/adr/0015-payment-gateway-adapter-stripe-first.md)
# =================================================================

# Provider for the payment gateway adapter seam.
# - manual: treasurer-recorded payments, no external provider (default,
#   keeps self-hosting credential-free)
# - stripe: Stripe adapter (requires both keys below; enforced at boot)
PAYMENT_GATEWAY=manual

# Stripe adapter credentials — required only when PAYMENT_GATEWAY=stripe.
# Restrict the secret key to this host; the webhook secret comes from
# `stripe listen` output or the dashboard endpoint's signing secret.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# =================================================================
# Optional: External Services
# =================================================================

# Sentry DSN (for error tracking)
# SENTRY_DSN=your-sentry-dsn

# Cloudflare API Token (for CDN management)
# CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# =================================================================
# Security Notes
# =================================================================

# - Never commit your actual .env file to version control
# - Use strong, randomly generated secrets in production
# - Rotate secrets periodically
# - Keep your .env file secure and only share with trusted team members
# - Use different secrets for development and production environments