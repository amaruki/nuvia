# Nuvia production environment — template for compose.prod.yml's `.env`.
#
# src/lib/env.ts validates every variable at boot and REFUSES TO START on
# missing or malformed required values. That is intentional: a
# misconfigured production deploy must fail to boot, not fail on the
# first request. See .env.example for the full annotated variable list;
# this file is the minimal production set.
#
# Required — the app will not boot without these:

# Public URL of the deployment (OAuth redirects, RFC 9457 problem `type`
# URIs, cache-session keys). Use the real domain, https.
APP_URL=https://nuvia.example.com

# Session/auth secret — minimum 32 characters. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=replac…ring

# The compose.prod.yml app container OVERRIDES this with the in-network
# URL (postgresql://nuvia:<POSTGRES_PASSWORD>@postgres:5432/nuvia), so
# this value only matters if you run the app outside compose. Still
# required by the boot validation.
DATABASE_URL=postgresql://nuvia:***@localhost:5432/nuvia

# Redis is REQUIRED in production (src/lib/env.ts): rate limiting and the
# session cache cannot run on the in-memory fallback across more than one
# process. compose.prod.yml overrides this with redis://redis:6379.
REDIS_URL=redis://localhost:6379

# Number of trusted reverse proxies between the client and the app
# (security issue #3). Default 1 = one TLS-terminating proxy (Caddy/nginx)
# in front, matching compose.prod.yml. Set 2 for a CDN/load balancer in
# front of your proxy; 0 only when the app is exposed directly (no proxy).
# See docs/DEPLOYMENT_PLAN.md "Reverse proxy & client-IP contract".
TRUSTED_PROXY_HOPS=1

NODE_ENV=production

# Strong password for the Postgres container (compose.prod.yml).
POSTGRES_PASSWORD=change…ring

# Client-facing values, inlined into the bundle at BUILD time — set them
# here AND pass them as compose build args (see compose.prod.yml).
NEXT_PUBLIC_APP_URL=https://nuvia.example.com
NEXT_PUBLIC_ENABLE_REDIS_CACHE=true

# --- Email (verification, password reset, invoices) -------------------
# Optional at boot, but the app logs "email functionality disabled"
# without them — i.e. signup verification and password reset do not work.
# Configure one provider for a real deployment.
# SMTP:
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USER=nuvia@example.com
# EMAIL_PASS=***
# EMAIL_FROM=nuvia@example.com
# or Resend:
# RESEND_API_KEY=***

# --- Payments ----------------------------------------------------------
# "manual" (default, credential-free) or "stripe". PAYMENT_GATEWAY=stripe
# without both keys below fails the boot — by design.
PAYMENT_GATEWAY=manual
# STRIPE_SECRET_KEY=***
# STRIPE_WEBHOOK_SECRET=***

# --- OAuth (optional; the provider is enabled only when both vars exist)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
***
# --- Seeding -----------------------------------------------------------
# `bun run scripts/seed.ts` REFUSES to run without an explicit password —
# an earlier seed script hardcoded one password across five privileged
# accounts (docs/adr/0009-security-hardening-p0.md). Use a strong one.
# SEED_ADMIN_PASSWORD=
***
# Feature flags (defaults shown).
FEATURE_EMAIL_VERIFICATION=true
FEATURE_SOCIAL_LOGIN=true
FEATURE_ACCOUNT_DELETION=true
FEATURE_PASSWORD_STRENGTH_METER=true

LOGGING_LEVEL=info
