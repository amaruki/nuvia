# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
#
# Previously this file opened with a blanket `.*` rule that ignored every
# dotfile in the repo, only carving out exceptions one at a time (!.gitignore,
# !.github, !.env.example). That meant .editorconfig, .nvmrc, and any oxlint/
# oxfmt/commitlint dotfile config could never be committed without a matching
# new exception — see docs/adr/0009-security-hardening-p0.md. Ignoring
# specific things by name, as below, is the safer default for an OSS repo.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
bun-debug.log*

# env files — keep secrets out; .env.example is the template and stays tracked
.env
.env.local
.env.*.local
.env.production
.env.development

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# drizzle
/drizzle/meta/*.json.bak
