{
  "name": "nuvia",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --inspect",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:integration": "bun run scripts/run-integration-tests.ts",
    "test:a11y": "bun run scripts/a11y-smoke.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run scripts/seed.ts",
    "db:reset": "drizzle-kit push --force && bun run db:seed",
    "prepare": "lefthook install",
    "guard:light": "bun run lint && bun run format:check && bun run typecheck",
    "guard:heavy": "bun run guard:light && bun run test:integration && bunx drizzle-kit check && bun run build && (bun audit --prod || true)",
    "guard": "bun run guard:heavy"
  },
  "dependencies": {
    "@hookform/resolvers": "5.5.7",
