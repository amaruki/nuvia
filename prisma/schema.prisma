// Consolidated Prisma Schema for Nuvia Community Platform
// This file combines all domain files into a single schema for now

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========================================
// SHARED ENUMS - Used across multiple domains
// ========================================

// Membership Enums

enum MembershipStatus {
  ACTIVE
  TRIALING
  CANCELED
  PAST_DUE
  UNPAID
  PAUSED
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELED
  REFUNDED
  PARTIALLY_REFUNDED
}

// Event Enums

enum EventType {
  CONFERENCE
  MEETUP
  WORKSHOP
  WEBINAR
  NETWORKING
  SOCIAL
  TRAINING
  PANEL_DISCUSSION
  KEYNOTE
  OTHER
}

enum EventFormat {
  IN_PERSON
  VIRTUAL
  HYBRID
  RECORDED
  LIVE_STREAM
}

enum EventStatus {
  DRAFT
  PUBLISHED
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  IN_PROGRESS
  COMPLETED
  CANCELED
  POSTPONED
}

enum EventVisibility {
  PUBLIC
  MEMBERS_ONLY
  PREMIUM_MEMBERS
  SPECIFIC_ROLES
  PRIVATE
  INVITE_ONLY
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  WAITLISTED
  CANCELED
  ATTENDED
  NO_SHOW
}

enum SponsorTier {
  PLATINUM
  GOLD
  SILVER
  BRONZE
  PARTNER
  MEDIA
}

// Forum Enums

enum PostType {
  DISCUSSION
  QUESTION
  ANNOUNCEMENT
  POLL
  RESOURCE
  JOB_POSTING
  EVENT_PROMOTION
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  DELETED
  HIDDEN
}

enum CommentStatus {
  PUBLISHED
  PENDING
  HIDDEN
  DELETED
}

// Content Enums

enum ContentType {
  ARTICLE
  BLOG_POST
  PAGE
  NEWS
  TUTORIAL
  DOCUMENTATION
  RESOURCE
  ANNOUNCEMENT
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  DELETED
  SCHEDULED
}

enum ContentVisibility {
  PUBLIC
  MEMBERS_ONLY
  PREMIUM_MEMBERS
  SPECIFIC_ROLES
  PRIVATE
}

// Job Board Enums

enum JobStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  CLOSED
  FILLED
  CANCELLED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  FREELANCE
  INTERNSHIP
  TEMPORARY
  VOLUNTEER
}

enum ExperienceLevel {
  ENTRY_LEVEL
  JUNIOR
  MID_LEVEL
  SENIOR
  LEAD
  EXECUTIVE
  NOT_SPECIFIED
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  SHORTLISTED
  REJECTED
  INTERVIEWING
  OFFERED
  HIRED
  WITHDRAWN
}

// ========================================
// USER MANAGEMENT MODELS
// ========================================

// User account model

model User {
  id                     String    @id @default(uuid())
  username               String    @unique
  email                  String    @unique
  emailVerified          Boolean   @default(false)
  firstName              String?
  lastName               String?
  profilePhoto           String?
  bio                    String?
  externalLinks          Json?
  role                   String    @default("user")
  passwordHash           String?
  emailVerificationToken String?   @unique
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime? @map("deleted_at")
  name                   String
  image                  String?

  // Relations
  loginActivities         UserLoginActivity[]
  activeDevices           ActiveDevice[]
  passwordResetTokens     PasswordResetToken[]
  accounts                Account[]
  sessions                Session[]
  membershipSubscriptions MembershipSubscription[]
  membershipTransactions  MembershipTransaction[]
  roleHistory             RoleChangeHistory[]
  createdAuthLogs         AuthLog[]                @relation("CreatedBy")
  eventRegistrations      EventRegistration[]
  forumPosts              ForumPost[]
  forumComments           ForumComment[]
  jobApplications         JobApplication[]
  createdEvents           Event[]                  @relation("EventCreator")
  createdContent          Content[]                @relation("ContentAuthor")
  postedJobs              JobPosting[]             @relation("JobPoster")
  userRoleAssignments     UserRoleAssignment[]

  displayName String?

  @@index([username])
  @@index([email])
  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

// User login activity tracking

model UserLoginActivity {
  id         String   @id @default(uuid())
  userId     String
  ipAddress  String
  userAgent  String?
  deviceType String?
  location   String?
  loginAt    DateTime @default(now())
  successful Boolean

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_login_activities")
}

// Active user devices

model ActiveDevice {
  id         String   @id @default(uuid())
  userId     String
  deviceId   String
  deviceName String?
  deviceType String?
  ipAddress  String?
  userAgent  String?
  lastActive DateTime @default(now())
  createdAt  DateTime @default(now())
  isActive   Boolean  @default(true)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@map("active_devices")
}

// Password reset tokens

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// ========================================
// AUTHENTICATION & AUTHORIZATION MODELS
// ========================================

// NextAuth.js / Better Auth compatible models

model Account {
  id                    String    @id @default(uuid())
  userId                String
  providerId            String
  accountId             String
  refreshToken          String?   @db.Text
  accessToken           String?   @db.Text
  accessTokenExpiresAt  DateTime?
  scope                 String?
  idToken               String?   @db.Text
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  refreshTokenExpiresAt DateTime?
  password              String?

  @@unique([providerId, accountId])
  @@map("accounts")
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  @@index([userId, expiresAt])
  @@index([token])
  @@index([expiresAt])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

// Custom Role Management

model CustomRole {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String?
  description String?
  permissions Json // Array of permission strings
  isSystem    Boolean  @default(false) // System roles cannot be deleted
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  users       UserRoleAssignment[]
  roleHistory RoleChangeHistory[]

  @@map("custom_roles")
}

// User Role Assignments (for custom roles)

model UserRoleAssignment {
  id         String    @id @default(uuid())
  userId     String
  roleId     String
  assignedBy String?
  assignedAt DateTime  @default(now())
  expiresAt  DateTime?
  isActive   Boolean   @default(true)

  // Relations
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role CustomRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_role_assignments")
}

// Role Change History

model RoleChangeHistory {
  id           String   @id @default(uuid())
  userId       String
  previousRole String
  newRole      String
  changedBy    String
  changedAt    DateTime @default(now())
  reason       String?
  ipAddress    String?
  userAgent    String?
  roleId       String? // Reference to CustomRole if applicable

  // Relations
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role CustomRole? @relation(fields: [roleId], references: [id])

  @@map("role_change_history")
}

// Authentication log model for security monitoring

model AuthLog {
  id        String   @id @default(uuid())
  userId    String?
  eventType String
  severity  String
  message   String
  ipAddress String?
  userAgent String?
  deviceId  String?
  location  String?
  metadata  Json?
  timestamp DateTime @default(now())
  createdBy User?    @relation("CreatedBy", fields: [userId], references: [id])

  @@map("auth_logs")
}

// ========================================
// MEMBERSHIP MANAGEMENT MODELS
// ========================================

// Membership tiers configuration

model MembershipTier {
  id           String   @id @default(uuid())
  name         String   @unique
  displayName  String
  description  String?
  price        Decimal  @db.Decimal(10, 2)
  billingCycle String // 'monthly', 'yearly', 'lifetime'
  features     Json // Array of features
  benefits     Json // Array of benefits
  permissions  Json // Array of permissions
  maxUsers     Int? // For corporate tiers
  isDefault    Boolean  @default(false)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  color        String? // UI color code
  icon         String? // Icon identifier
  trialDays    Int      @default(0)
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  subscriptions MembershipSubscription[]
  transactions  MembershipTransaction[]

  @@map("membership_tiers")
}

// User membership subscriptions

model MembershipSubscription {
  id                 String           @id @default(uuid())
  userId             String
  tierId             String
  status             MembershipStatus
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime?
  trialStart         DateTime?
  trialEnd           DateTime?
  cancelAtPeriodEnd  Boolean          @default(false)
  canceledAt         DateTime?
  metadata           Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  // Relations
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier         MembershipTier          @relation(fields: [tierId], references: [id])
  transactions MembershipTransaction[]

  @@unique([userId, tierId])
  @@map("membership_subscriptions")
}

// Membership payment transactions

model MembershipTransaction {
  id              String            @id @default(uuid())
  userId          String
  subscriptionId  String
  tierId          String
  amount          Decimal           @db.Decimal(10, 2)
  currency        String            @default("USD")
  status          TransactionStatus
  paymentMethod   String?
  paymentProvider String?
  providerTxId    String?
  description     String?
  metadata        Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription MembershipSubscription @relation(fields: [subscriptionId], references: [id])
  tier         MembershipTier         @relation(fields: [tierId], references: [id])

  @@map("membership_transactions")
}

// ========================================
// EVENTS MANAGEMENT MODELS
// ========================================

// Event categories

model EventCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String?
  description String?
  color       String? // UI color code
  icon        String? // Icon identifier
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  events Event[]

  @@map("event_categories")
}

// Events

model Event {
  id                String          @id @default(uuid())
  title             String
  slug              String          @unique
  description       String?
  shortDescription  String?
  categoryId        String
  type              EventType
  format            EventFormat
  status            EventStatus
  visibility        EventVisibility
  capacity          Int?
  registeredCount   Int             @default(0)
  waitlistCount     Int             @default(0)
  isVirtual         Boolean         @default(false)
  isFree            Boolean         @default(true)
  price             Decimal?        @db.Decimal(10, 2)
  currency          String          @default("USD")
  location          String?
  virtualUrl        String?
  timezone          String
  startTime         DateTime
  endTime           DateTime
  registrationStart DateTime?
  registrationEnd   DateTime?
  allowWaitlist     Boolean         @default(true)
  requiresApproval  Boolean         @default(false)
  tags              String[] // Array of tags
  metadata          Json?
  createdBy         String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Relations
  category      EventCategory       @relation(fields: [categoryId], references: [id])
  creator       User                @relation("EventCreator", fields: [createdBy], references: [id])
  registrations EventRegistration[]
  speakers      EventSpeaker[]
  sponsors      EventSponsor[]
  sessions      EventSession[]

  @@index([categoryId])
  @@index([type])
  @@index([status])
  @@index([startTime])
  @@index([createdBy])
  @@map("events")
}

// Event registrations

model EventRegistration {
  id           String             @id @default(uuid())
  userId       String
  eventId      String
  status       RegistrationStatus @default(PENDING)
  registeredAt DateTime           @default(now())
  checkedInAt  DateTime?
  checkedOutAt DateTime?
  qrCode       String?
  ticketData   Json?
  metadata     Json?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@map("event_registrations")
}

// Event speakers

model EventSpeaker {
  id        String   @id @default(uuid())
  eventId   String
  name      String
  bio       String?
  title     String?
  company   String?
  photo     String?
  email     String?
  order     Int      @default(0)
  isKeynote Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_speakers")
}

// Event sponsors

model EventSponsor {
  id          String      @id @default(uuid())
  eventId     String
  name        String
  logo        String?
  website     String?
  description String?
  tier        SponsorTier @default(BRONZE)
  order       Int         @default(0)
  isActive    Boolean     @default(true)
  metadata    Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_sponsors")
}

// Event sessions (for multi-session events)

model EventSession {
  id          String   @id @default(uuid())
  eventId     String
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  location    String?
  virtualUrl  String?
  speakers    Json? // Array of speaker information
  order       Int      @default(0)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_sessions")
}

// ========================================
// CONTENT MANAGEMENT MODELS
// ========================================

// Forum categories

model ForumCategory {
  id           String   @id @default(uuid())
  name         String   @unique
  displayName  String
  description  String?
  icon         String?
  color        String?
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  isPrivate    Boolean  @default(false)
  requiredRole String? // Minimum role to access
  parentId     String?
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  parent   ForumCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children ForumCategory[] @relation("CategoryHierarchy")
  posts    ForumPost[]

  @@map("forum_categories")
}

// Forum posts

model ForumPost {
  id          String     @id @default(uuid())
  categoryId  String
  userId      String
  title       String
  content     String
  type        PostType   @default(DISCUSSION)
  status      PostStatus @default(PUBLISHED)
  isSticky    Boolean    @default(false)
  isLocked    Boolean    @default(false)
  views       Int        @default(0)
  likeCount   Int        @default(0)
  replyCount  Int        @default(0)
  lastReplyAt DateTime?
  tags        String[] // Array of tags
  metadata    Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  category    ForumCategory     @relation(fields: [categoryId], references: [id])
  author      User              @relation(fields: [userId], references: [id])
  comments    ForumComment[]
  attachments ForumAttachment[]

  @@index([categoryId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([isSticky])
  @@map("forum_posts")
}

// Forum comments

model ForumComment {
  id        String        @id @default(uuid())
  postId    String
  userId    String
  content   String
  parentId  String? // For nested comments
  status    CommentStatus @default(PUBLISHED)
  likeCount Int           @default(0)
  metadata  Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Relations
  post    ForumPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User           @relation(fields: [userId], references: [id])
  parent  ForumComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies ForumComment[] @relation("CommentReplies")

  @@index([postId])
  @@index([userId])
  @@index([parentId])
  @@index([createdAt])
  @@map("forum_comments")
}

// Forum attachments

model ForumAttachment {
  id           String   @id @default(uuid())
  postId       String
  userId       String
  filename     String
  originalName String
  mimeType     String
  size         Int
  path         String
  metadata     Json?
  createdAt    DateTime @default(now())

  // Relations
  post ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("forum_attachments")
}

// Content management

model Content {
  id            String            @id @default(uuid())
  title         String
  slug          String            @unique
  content       String
  excerpt       String?
  type          ContentType
  status        ContentStatus     @default(DRAFT)
  visibility    ContentVisibility @default(PUBLIC)
  categoryId    String?
  authorId      String
  featuredImage String?
  tags          String[] // Array of tags
  metadata      Json?
  publishedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // Relations
  category ContentCategory? @relation(fields: [categoryId], references: [id])
  author   User             @relation("ContentAuthor", fields: [authorId], references: [id])

  @@index([type])
  @@index([status])
  @@index([authorId])
  @@index([publishedAt])
  @@map("content")
}

// Content categories

model ContentCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String
  description String?
  icon        String?
  color       String?
  parentId    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  parent   ContentCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children ContentCategory[] @relation("CategoryHierarchy")
  content  Content[]

  @@map("content_categories")
}

// ========================================
// JOB BOARD MANAGEMENT MODELS
// ========================================

// Job categories

model JobCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String
  description String?
  icon        String?
  color       String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  jobs JobPosting[]

  @@map("job_categories")
}

// Job types

model JobType {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String
  description String?
  isActive    Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  jobs JobPosting[]

  @@map("job_types")
}

// Locations

model Location {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String
  country     String?
  state       String?
  city        String?
  remote      Boolean  @default(false)
  timezone    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  jobs JobPosting[]

  @@map("locations")
}

// Companies

model Company {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String
  description String?
  logo        String?
  website     String?
  industry    String?
  size        String? // Company size (e.g., "1-10", "11-50", etc.)
  foundedYear Int?
  location    String?
  isVerified  Boolean  @default(false)
  isActive    Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  jobs JobPosting[]

  @@map("companies")
}

// Job postings

model JobPosting {
  id                  String          @id @default(uuid())
  title               String
  slug                String          @unique
  description         String
  requirements        String?
  responsibilities    String?
  benefits            String?
  categoryId          String
  typeId              String
  locationId          String
  companyId           String
  postedBy            String
  status              JobStatus       @default(DRAFT)
  employmentType      EmploymentType
  experienceLevel     ExperienceLevel
  salaryMin           Decimal?        @db.Decimal(10, 2)
  salaryMax           Decimal?        @db.Decimal(10, 2)
  currency            String          @default("USD")
  isRemote            Boolean         @default(false)
  isFeatured          Boolean         @default(false)
  applicationDeadline DateTime?
  viewCount           Int             @default(0)
  applicationCount    Int             @default(0)
  tags                String[] // Array of tags
  metadata            Json?
  publishedAt         DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  // Relations
  category     JobCategory      @relation(fields: [categoryId], references: [id])
  type         JobType          @relation(fields: [typeId], references: [id])
  location     Location         @relation(fields: [locationId], references: [id])
  company      Company          @relation(fields: [companyId], references: [id])
  postedByUser User             @relation("JobPoster", fields: [postedBy], references: [id])
  applications JobApplication[]

  @@index([categoryId])
  @@index([typeId])
  @@index([locationId])
  @@index([companyId])
  @@index([status])
  @@index([publishedAt])
  @@index([isFeatured])
  @@map("job_postings")
}

// Job applications

model JobApplication {
  id                String            @id @default(uuid())
  jobId             String
  userId            String
  status            ApplicationStatus @default(PENDING)
  coverLetter       String?
  resumePath        String?
  portfolioUrl      String?
  salaryExpectation Decimal?          @db.Decimal(10, 2)
  availability      String?
  notes             String?
  metadata          Json?
  appliedAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // Relations
  job       JobPosting @relation(fields: [jobId], references: [id])
  applicant User       @relation(fields: [userId], references: [id])

  @@unique([jobId, userId])
  @@map("job_applications")
}
